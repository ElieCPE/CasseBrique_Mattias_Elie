class Brique:

    def __init__(self, x1, y1, x2, y2, canvas, points=10,
                 resistance=1, couleur="seagreen"):
        self.canvas = canvas
        self.x1, self.y1, self.x2, self.y2 = x1, y1, x2, y2
        self.points = points
        self.resistance = resistance
        self.couleur = couleur
        self.detruite = False
        self.id = canvas.create_rectangle(x1, y1, x2, y2, fill=couleur, outline="#17202a", width=2)


#Renvoie les points gagnés lors de l'impact.
    def touche(self):
        if self.detruite:
            return 0

        self.resistance -= 1
        if self.resistance <= 0:
            self.detruite = True
            self.canvas.delete(self.id)
            return self.points

# Une brique résistante change de couleur après un impact.
        self.canvas.itemconfigure(self.id, fill="gold")
        return 0



#verifie si la balle touche la brique
    def contient(self, x, y, rayon):
        return (x + rayon >= self.x1 and x - rayon <= self.x2 and y + rayon >= self.y1 and y - rayon <= self.y2)
