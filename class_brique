class Brique:
    """Une brique qui peut nécessiter plusieurs impacts avant de disparaître."""

    def __init__(self, x1, y1, x2, y2, canvas, points=10, resistance=1, couleur="seagreen"):
        self.canvas = canvas
        self.x1, self.y1, self.x2, self.y2 = x1, y1, x2, y2
        self.points = points
        self.resistance = resistance
        self.couleur = couleur
        self.detruite = False
        self.id = canvas.create_rectangle(x1, y1, x2, y2, fill=couleur, outline="#17202a", width=2)


    def touche(self):
        """Renvoie les points gagnés lors de l'impact."""
        if self.detruite:
            return 0

        self.resistance -= 1
        if self.resistance <= 0:
            self.detruite = True
            self.canvas.delete(self.id)
            return self.points

