class Raquette:
    def __init__(self, x, y, canvas, largeur=110, hauteur=14, couleur="deepskyblue"):
        self.x = x
        self.y = y
        self.canvas = canvas
        self.largeur = largeur
        self.hauteur = hauteur
        self.couleur = couleur
