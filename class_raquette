class Raquette:
    def __init__(self, x, y, canvas, largeur=110, hauteur=14, couleur="deepskyblue"):
        self.x = x
        self.y = y
        self.canvas = canvas
        self.largeur = largeur
        self.hauteur = hauteur
        self.couleur = couleur
        self.vitesse = 9
        self.id = canvas.create_rectangle(
            x - largeur / 2, y - hauteur / 2,
            x + largeur / 2, y + hauteur / 2,
            fill = couleur, outline= ""
        )
    def deplacer(self, direction, largeur_canvas):

        """direction vaut -1 (gauche), 0 (immobile) ou 1 (droite)"""

        self.x += direction * self.vitesse
        demi = self.largeur / 2
        self.x = max(demi, min(largeur_canvas - demi, self.x))
        self.canvas.coords(
            self.id,
            self.x - demi, self.y - self.hauteur / 2,
            self.x + demi, self.y + self.hauteur / 2
        )

    def contient_x(self, x):
        return self.x - self.largeur / 2 <= x <= self.x + self.largeur / 2

    def supprimer(self):
        self.canvas.delete(self.id)